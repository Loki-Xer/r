<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.lokixer.tunetube.ui.SquareImageView
            android:id="@+id/plCover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_thumb_large"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/plMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/bg_mini"
            android:contentDescription="More"
            android:padding="9dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/text" />
    </FrameLayout>

    <TextView
        android:id="@+id/plName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/plCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/nav_inactive"
        android:textSize="13sp" />
</LinearLayout>
